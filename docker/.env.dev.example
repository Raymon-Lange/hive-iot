# Local dev env — copy to .env before running: cp .env.dev.example .env
# Do not commit .env. See hive-ops/standards/04-environment-variables.md

# Domain the app is served from in local dev.
APP_DOMAIN=localhost

# Storage backend mode for local dev.
STORAGE_MODE=local

# Filesystem path used when STORAGE_MODE=local.
STORAGE_PATH=.

# Hostname of the Mosquitto MQTT broker (matches the mosquitto service name).
MQTT_BROKER_HOST=mosquitto

# Port the Mosquitto MQTT broker listens on.
MQTT_BROKER_PORT=1883

# Path to the SQLite database file inside the api container.
HIVE_DB_PATH=/app/data/hive_iot.db

# Base URL the dashboard uses to reach the API.
VITE_API_URL=http://localhost:8010
