# Platform — required by all apps
APP_NAME=hive-iot
APP_DOMAIN=hive-iot.example.com
# Controls the Docker container name prefix (hive-iot-mosquitto, hive-iot-api, hive-iot-dashboard)
COMPOSE_PROJECT_NAME=${APP_NAME}

STORAGE_MODE=local
STORAGE_PATH=/home/deploy

# Set to your local timezone. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# --- hive-iot ---
# These predate the hive-ops app-name-prefix convention and are read
# directly by application code (services/api, dashboard build) — renaming
# them would require code changes, out of scope for this deploy refactor.

# Hostname of the Mosquitto MQTT broker, as seen by the api container.
MQTT_BROKER_HOST=mosquitto
# Port the Mosquitto MQTT broker listens on.
MQTT_BROKER_PORT=1883
# Path to the SQLite database file inside the api container.
HIVE_DB_PATH=/app/data/hive_iot.db
# Base URL the dashboard's browser bundle uses to reach the API. This is
# baked in at CI build time (Vite), not read at container runtime — kept
# here for documentation/parity, but changing it requires a rebuild+redeploy,
# not just editing .env. See README.md's Environment variables section.
VITE_API_URL=http://hive-iot.example.com:8010
